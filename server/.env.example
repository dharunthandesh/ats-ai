# ==============================================================================
# TalentPulse ATS - Environment Configuration Template
# NOTE: Copy this file to .env and configure values before starting the application.
# NEVER commit the active .env file or real credentials into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server Settings
# ------------------------------------------------------------------------------
# [Optional] Port for backend Express HTTP server (Default: 5000)
PORT=5000

# [Optional] Application execution environment ('development' | 'production' | 'test')
NODE_ENV=development

# [Optional] Allowed Cross-Origin Resource Sharing origin (Default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# [Optional in Dev / Required for Production Persistence]
# Connection URI for MongoDB replica set, standalone instance, or MongoDB Atlas cluster.
# In development, if MONGODB_URI is empty or inaccessible, the backend automatically
# falls back to an embedded in-memory MongoDB server (mongodb-memory-server).
# Example: mongodb://127.0.0.1:27017/talentpulse_ats
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/talentpulse_ats?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/talentpulse_ats

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# [REQUIRED in Production] Secret key for signing and verifying JSON Web Tokens (min 32 characters).
# If omitted in development mode, a default local development key is used.
# Production strictly halts if this variable is missing.
JWT_SECRET=your_strong_random_jwt_secret_min_32_characters_here

# [Optional] Expiration duration for signed user sessions (Default: 24h)
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# File Upload Configuration
# ------------------------------------------------------------------------------
# [Optional] Relative path where resume documents are stored on the server filesystem
UPLOAD_DIR=uploads/resumes

# [Optional] Maximum permitted resume file size in Megabytes (Default: 10)
MAX_FILE_SIZE_MB=10

# ------------------------------------------------------------------------------
# Email / Notification Delivery (Optional)
# ------------------------------------------------------------------------------
# If SMTP_USER and SMTP_PASS are omitted, the server runs in Mock Mode,
# printing simulated notification emails (interview invites, offer letters, rejections)
# directly to the console without failing.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TalentPulse ATS" <no-reply@talentpulse.ai>
